-- The current state of every note that is not deleted forever, materialised from its head
-- revision: what the UI and search read. fts_rowid exists only because an FTS5 index with
-- external content needs an integer key.
CREATE TABLE note (
  fts_rowid INTEGER PRIMARY KEY,
  id TEXT NOT NULL UNIQUE,
  revision_id TEXT NOT NULL REFERENCES revision(id),
  is_pinned INTEGER AS kotlin.Boolean NOT NULL CHECK (is_pinned IN (0, 1)),
  state TEXT NOT NULL CHECK (state IN ('ACTIVE', 'ARCHIVED', 'TRASHED')),
  -- The physical time of the earliest stored revision, the note's first.
  created_at_millis INTEGER NOT NULL,
  updated_hlc_physical INTEGER NOT NULL CHECK (updated_hlc_physical >= 0),
  updated_hlc_counter INTEGER NOT NULL CHECK (updated_hlc_counter BETWEEN 0 AND 2147483647),
  -- The text comes last: a long body spills into overflow pages, which a query that needs only
  -- the columns before it (ranking, filtering) then does not read.
  title TEXT NOT NULL,
  body TEXT NOT NULL
);

-- The list order: pinned first, then the most recently updated.
CREATE INDEX note_by_list_order
  ON note(state, is_pinned DESC, updated_hlc_physical DESC, updated_hlc_counter DESC);

-- The materialised tags. The tag list is a GROUP BY over this table; there is no tag table.
CREATE TABLE note_tag (
  note_id TEXT NOT NULL REFERENCES note(id) ON DELETE CASCADE,
  tag TEXT NOT NULL,
  PRIMARY KEY (note_id, tag)
) WITHOUT ROWID;

CREATE INDEX note_tag_by_tag ON note_tag(tag, note_id);

-- The full-text index over title and body. External content: the text lives only in `note`, and
-- the triggers below keep the index in step with it. `remove_diacritics 2` folds accents, so
-- "cafe" finds "café". The prefix indexes make the prefix match of the last word that search
-- adds fast for two and three letters; a short prefix otherwise merges the lists of every word
-- that starts with it (see README.md).
CREATE VIRTUAL TABLE note_fts USING fts5(
  title,
  body,
  content = 'note',
  content_rowid = 'fts_rowid',
  tokenize = 'unicode61 remove_diacritics 2',
  prefix = '2 3'
);

CREATE TRIGGER note_fts_after_insert AFTER INSERT ON note BEGIN
  INSERT INTO note_fts(rowid, title, body) VALUES (new.fts_rowid, new.title, new.body);
END;

CREATE TRIGGER note_fts_after_delete AFTER DELETE ON note BEGIN
  INSERT INTO note_fts(note_fts, rowid, title, body)
  VALUES ('delete', old.fts_rowid, old.title, old.body);
END;

-- Only when the text changed: pinning or archiving a note does not touch the index.
CREATE TRIGGER note_fts_after_update AFTER UPDATE OF title, body ON note
WHEN old.title IS NOT new.title OR old.body IS NOT new.body
BEGIN
  INSERT INTO note_fts(note_fts, rowid, title, body)
  VALUES ('delete', old.fts_rowid, old.title, old.body);
  INSERT INTO note_fts(rowid, title, body) VALUES (new.fts_rowid, new.title, new.body);
END;

-- Inserts the note, or updates every column but fts_rowid. The creation time is the earliest
-- stored revision's: a user revision is stamped after its parents and an automatic merge copies a
-- parent's timestamp, so that is the first revision's. It is recomputed on every update because
-- in M3 a revision can arrive before its ancestors; it can then only move back. revision_by_note
-- answers it from the index.
upsertNote:
INSERT INTO note(
  id, revision_id, title, body, is_pinned, state, created_at_millis,
  updated_hlc_physical, updated_hlc_counter
) VALUES (
  :id, :revisionId, :title, :body, :isPinned, :state,
  (SELECT min(hlc_physical) FROM revision WHERE note_id = :id),
  :updatedPhysical, :updatedCounter
)
ON CONFLICT (id) DO UPDATE SET
  revision_id = excluded.revision_id,
  title = excluded.title,
  body = excluded.body,
  is_pinned = excluded.is_pinned,
  state = excluded.state,
  created_at_millis = excluded.created_at_millis,
  updated_hlc_physical = excluded.updated_hlc_physical,
  updated_hlc_counter = excluded.updated_hlc_counter;

-- Its note_tag rows go with it (ON DELETE CASCADE).
deleteNote:
DELETE FROM note WHERE id = :id;

-- With insertTag, replaces a note's tags without rewriting the ones it keeps.
deleteTagsExcept:
DELETE FROM note_tag WHERE note_id = :noteId AND tag NOT IN :kept;

insertTag:
INSERT OR IGNORE INTO note_tag(note_id, tag) VALUES (:noteId, :tag);

-- The tags are joined with U+001F, which a tag cannot contain (it is a control character).
selectNote:
SELECT
  id, revision_id, title, body, is_pinned, state, created_at_millis,
  updated_hlc_physical, updated_hlc_counter,
  (SELECT group_concat(tag, char(31)) FROM note_tag WHERE note_id = note.id) AS tags
FROM note
WHERE id = :id;

-- The list order: pinned first, then the most recently updated, then by id, so that it is total.
-- :tag is null for every tag.
selectNotes:
SELECT
  id, revision_id, title, body, is_pinned, state, created_at_millis,
  updated_hlc_physical, updated_hlc_counter,
  (SELECT group_concat(tag, char(31)) FROM note_tag WHERE note_id = note.id) AS tags
FROM note
WHERE state = :state
  AND (:tag IS NULL OR id IN (SELECT note_id FROM note_tag WHERE tag = :tag))
ORDER BY is_pinned DESC, updated_hlc_physical DESC, updated_hlc_counter DESC, id;

-- The tags of notes that are not in the trash, with how many such notes have each.
selectTagCounts:
SELECT note_tag.tag, count(*) AS note_count
FROM note_tag JOIN note ON note.id = note_tag.note_id
WHERE note.state != 'TRASHED'
GROUP BY note_tag.tag
ORDER BY note_tag.tag;

-- The best :limit matches of :query (FTS5 syntax), ranked by bm25 with the title weighing ten
-- times the body, ties in list order. The inner query ranks every match without touching its
-- text; the outer one makes the title and body snippets only for the hits it returns.
-- Matches are marked with U+E000 and U+E001 (char(57344), char(57345)); char(8230) is the
-- ellipsis where an excerpt leaves text out.
-- SQLDelight 2.4.1 cannot generate code for an unaliased FTS5 rowid column, so the hits are
-- picked by note.fts_rowid, the same value.
search:
WITH hit AS (
  SELECT note.fts_rowid AS hit_rowid
  FROM note_fts JOIN note ON note.fts_rowid = note_fts.rowid
  WHERE note_fts MATCH :query
    AND note.state = :state
    AND (:tag IS NULL OR note.id IN (SELECT note_id FROM note_tag WHERE tag = :tag))
  ORDER BY bm25(note_fts, 10.0, 1.0), note.is_pinned DESC, note.updated_hlc_physical DESC,
    note.updated_hlc_counter DESC, note.id
  LIMIT :limit
)
SELECT
  note.id, note.revision_id, note.title, note.body, note.is_pinned, note.state,
  note.created_at_millis, note.updated_hlc_physical, note.updated_hlc_counter,
  (SELECT group_concat(tag, char(31)) FROM note_tag WHERE note_tag.note_id = note.id) AS tags,
  snippet(note_fts, 0, char(57344), char(57345), char(8230), 24) AS title_snippet,
  snippet(note_fts, 1, char(57344), char(57345), char(8230), 24) AS body_snippet
FROM note_fts JOIN note ON note.fts_rowid = note_fts.rowid
WHERE note_fts MATCH :query AND note.fts_rowid IN (SELECT hit_rowid FROM hit)
ORDER BY bm25(note_fts, 10.0, 1.0), note.is_pinned DESC, note.updated_hlc_physical DESC,
  note.updated_hlc_counter DESC, note.id;
