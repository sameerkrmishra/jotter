<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and earlier: the same as data_extraction_rules.xml. The notes database only, and in
    a cloud backup only if it is encrypted on the device (requireFlags, from Android 9; earlier
    versions ignore it). Backend secrets are in noBackupFilesDir, which is never copied.
-->
<full-backup-content>
    <include domain="database" path="jotter.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="jotter.db-wal" requireFlags="clientSideEncryption" />
</full-backup-content>
