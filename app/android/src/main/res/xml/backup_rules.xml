<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8.0 and 8.1 (API 26 and 27): nothing is backed up (ADR-0018). These versions cannot
    require a backup to be encrypted on the device, so the notes stay out of it. Android 9 and
    later use xml-v28/backup_rules.xml, and Android 12 and later data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
