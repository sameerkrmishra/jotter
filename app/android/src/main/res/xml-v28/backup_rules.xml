<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9 to 11: the same as data_extraction_rules.xml. The notes database only, and in
    a cloud backup only if it is encrypted on the device (requireFlags). Android 8 backs up
    nothing (xml/backup_rules.xml). Backend secrets are in noBackupFilesDir, never copied.
-->
<full-backup-content>
    <include domain="database" path="jotter.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="jotter.db-wal" requireFlags="clientSideEncryption" />
</full-backup-content>
